<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher foreground: the DeepConnect "aurora shield" mark — a gradient shield
  with an inner portal ring and a bright core, echoing the in-app connection orb.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shield body with the aurora gradient -->
    <path android:pathData="M54,24 L78,33 L78,55 C78,70 67.5,80.5 54,85 C40.5,80.5 30,70 30,55 L30,33 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="34"
                android:startY="28"
                android:endX="76"
                android:endY="82"
                android:startColor="#FF8AF7D3"
                android:centerColor="#FF3FE3AC"
                android:endColor="#FF1B8F7D" />
        </aapt:attr>
    </path>

    <!-- Inner shadow ring -->
    <path
        android:pathData="M54,39 C46.8,39 41,44.8 41,52 C41,59.2 46.8,65 54,65 C61.2,65 67,59.2 67,52 C67,44.8 61.2,39 54,39 Z M54,44 C58.4,44 62,47.6 62,52 C62,56.4 58.4,60 54,60 C49.6,60 46,56.4 46,52 C46,47.6 49.6,44 54,44 Z"
        android:fillColor="#CC06131A"
        android:fillType="evenOdd" />

    <!-- Portal core -->
    <path
        android:pathData="M54,48.5 A3.5,3.5 0 1,1 54,55.5 A3.5,3.5 0 1,1 54,48.5 Z"
        android:fillColor="#FF06131A" />

    <!-- Specular highlight along the upper-left edge -->
    <path
        android:pathData="M38,44 C38,37 43,31.5 50,29.5"
        android:strokeColor="#66FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
</vector>
